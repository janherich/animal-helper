{
  "name": "animal-helper",
  "version": "0.0.0",
  "private": true,
  "description": "Open-source infrastructure for reporting and coordinating help for animals in Slovakia.",
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@11.18.0",
  "engines": {
    "node": ">=24 <27",
    "pnpm": "11.18.0"
  },
  "scripts": {
    "build": "pnpm --recursive --if-present build",
    "check": "node scripts/require-node.mjs && pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "dev": "node scripts/dev.mjs",
    "dev:status": "node scripts/local-postgres.mjs status",
    "dev:stop": "node scripts/local-postgres.mjs stop",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "test": "pnpm --recursive --if-present test",
    "test:integration": "pnpm --filter @animal-helper/event-store test:integration",
    "typecheck": "pnpm --recursive --if-present typecheck"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.3",
    "eslint": "10.9.0",
    "prettier": "3.9.6",
    "typescript": "6.0.3",
    "typescript-eslint": "8.67.0",
    "vitest": "4.1.11"
  }
}
