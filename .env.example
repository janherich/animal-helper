# Local Docker values are generated in .local/db.env (gitignored) by
# `pnpm db:up`. Do not copy that file into production, and do not point
# these variables at a hosted database from a developer machine.

# CAPABILITY_PEPPER=
# API_HOST=127.0.0.1
# API_PORT=8787
# API_CORS_ORIGIN=http://127.0.0.1:5173
# ADMIN_ORIGIN=http://localhost:5174
# VITE_API_BASE_URL=http://127.0.0.1:8787
# DATABASE_TEST_URL is generated in .local/db.env for integration tests.
# Do not point it at the application database or at production.

# Production (Neon). Set these in the host secret store, never in git.
# DATABASE_ENVIRONMENT=production
# DATABASE_URL=                      # pooled Neon connection
# DATABASE_MIGRATION_URL=            # direct Neon connection
# DATABASE_SSL_MODE=verify
# DATABASE_POOL_SIZE=8
# CAPABILITY_PEPPER=
# ADMIN_ORIGIN=                      # exact https origin of the admin SPA
