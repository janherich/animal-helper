{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "declaration": false,
    "declarationMap": false,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["vite/client", "node"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src/**/*.ts", "src/**/*.vue", "src/**/*.d.ts", "*.config.ts", "e2e/**/*.ts"],
  "vueCompilerOptions": {
    "plugins": ["@vue/language-plugin-pug"],
    "strictTemplates": true
  }
}
